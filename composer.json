{
    "name": "omnifilm/tmdb",
    "type": "library",
    "description": "Omnifilm's The Movie Database, under any PHP host, over php-tmdb/api: search, a film's or a series' record with its cast, crew and identifiers across registers in one call, an episode by its IMDb or TheTVDB number, a season's episodes, and where to watch in a country (JustWatch's data); php-tmdb's client runs over the application's HTTP client and a PSR-14 dispatcher of its own.",
    "keywords": ["tmdb", "themoviedb", "film", "movie", "tv", "series", "episode", "watch-providers", "framework-agnostic", "omnifilm"],
    "homepage": "https://github.com/glitchr-studio/omnifilm-tmdb",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nyholm/psr7": "^1.8",
        "omniscient/omnifilm": "^1.0@dev",
        "php-tmdb/api": "^4.1",
        "psr/event-dispatcher": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "provide": {
        "psr/event-dispatcher-implementation": "1.0"
    },
    "autoload": {
        "psr-4": {
            "Omnifilm\\Tmdb\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnifilm\\Tmdb\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    }
}
